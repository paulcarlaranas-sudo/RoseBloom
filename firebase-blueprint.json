{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information and credentials metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "googleLinked": { "type": "boolean" },
        "googleEmail": { "type": "string", "maxLength": 150 },
        "avatarUrl": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 30 }
      },
      "required": ["id", "name", "email", "createdAt"]
    },
    "UserSite": {
      "title": "UserSite",
      "description": "Romantic love letter project created by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "girlfriendName": { "type": "string", "maxLength": 100 },
        "senderName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "string", "maxLength": 30 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerEmail": { "type": "string", "maxLength": 150 },
        "shareCode": { "type": "string", "maxLength": 20 },
        "receiverToken": { "type": "string", "maxLength": 64 },
        "isPrivate": { "type": "boolean" },
        "data": { "type": "object" }
      },
      "required": ["id", "title", "girlfriendName", "senderName", "ownerId", "data", "createdAt"]
    },
    "SharedSite": {
      "title": "SharedSite",
      "description": "Publicly accessible snapshot of a love letter for a recipient",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "girlfriendName": { "type": "string", "maxLength": 100 },
        "senderName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 30 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "shareCode": { "type": "string", "maxLength": 20 },
        "receiverToken": { "type": "string", "maxLength": 64 },
        "data": { "type": "object" }
      },
      "required": ["id", "title", "girlfriendName", "senderName", "ownerId", "data"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores individual user profile data accessible only by the account owner"
    },
    "/users/{userId}/sites/{siteId}": {
      "schema": "UserSite",
      "description": "Stores romantic sites and letters belonging to a specific user"
    },
    "/shared_sites/{shareKey}": {
      "schema": "SharedSite",
      "description": "Public recipient lookup by share code or token so recipients can view the romantic letter"
    }
  }
}
